{
  "name": "@reasonix/ui",
  "version": "0.1.0",
  "description": "Reasonix design system component library — 38 shadcn-style components with multi-direction theming, motion tokens and a design spec.",
  "author": "Reasonix Design",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangmaituan882-hue/reasonix.git"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "shadcn",
    "theme"
  ],
  "license": "MIT",
  "peerDependencies": {
    "cmdk": "^1.1.0",
    "embla-carousel-react": "^8.0.0",
    "next-themes": "^0.4.0",
    "radix-ui": "^1.6.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-resizable-panels": "^4.0.0",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "vaul": "^1.1.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "pack": "npm run build && npm pack"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.77.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
